{
  "family": "learning-infra-alb-web",
  "networkMode": "bridge",
  "requiresCompatibilities": ["EC2"],
  "cpu": "256",
  "memory": "128",
  "containerDefinitions": [
    {
      "name": "web",
      "image": "nginx:1.27-alpine",
      "essential": true,
      "command": [
        "/bin/sh",
        "-c",
        "printf 'learning-infra-alb-ok' >/usr/share/nginx/html/saude && nginx -g 'daemon off;'"
      ],
      "portMappings": [
        {"containerPort": 80, "hostPort": 18081, "protocol": "tcp"}
      ]
    }
  ]
}

